{
  "name": "@pm2/io",
  "version": "7.0.0-dev4",
  "description": "PM2.io NodeJS APM",
  "main": "build/main/index.js",
  "typings": "build/main/index.d.ts",
  "types": "build/main/index.d.ts",
  "module": "build/module/index.js",
  "repository": "https://github.com/keymetrics/pm2-io-apm",
  "author": {
    "name": "PM2.io tech team",
    "email": "tech@pm2.io",
    "url": "https://pm2.io"
  },
  "contributors": [
    {
      "name": "Vincent Vallet",
      "url": "https://github.com/wallet77"
    }
  ],
  "license": "Apache-2",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:module": "tsc -p config/exports/tsconfig.module.json",
    "lint": "eslint src/**/*.ts test/**/*.ts --no-warn-ignored",
    "unit": "npm run build && bash test.sh",
    "mono": "mocha  --exit --require ts-node/register",
    "test": "npm run unit",
    "watch": "tsc -w",
    "prepublishOnly": "npm run build"
  },
  "scripts-info": {
    "build": "(Trash and re)build the library",
    "lint": "Lint all typescript source files",
    "unit": "Build the library and run unit tests",
    "test": "Lint, build, and test the library",
    "watch": "Watch source files, rebuild library on changes, rerun relevant tests"
  },
  "engines": {
    "node": ">=20.0"
  },
  "devDependencies": {
    "@types/chai": "4.1.4",
    "@types/debug": "^4.1.12",
    "@types/express": "~4.16.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "~20.0.0",
    "@types/semver": "^7.7.1",
    "@types/shimmer": "^1.2.0",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "chai": "4.1.2",
    "eslint": "^9.39.1",
    "express": "^4.17.1",
    "koa": "^2.11.0",
    "mocha": "^10.8.2",
    "nyc": "^15.1.0",
    "source-map-support": "~0.5.9",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "vue": "^2.6.11",
    "vue-server-renderer": "^2.6.11"
  },
  "keywords": [],
  "nyc": {
    "extension": [
      ".ts"
    ],
    "exclude": [
      "build/",
      "config/",
      "examples/",
      "test/"
    ],
    "cache": true,
    "all": true
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.55.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.57.0",
    "@opentelemetry/exporter-zipkin": "^1.30.0",
    "@opentelemetry/sdk-node": "^0.57.0",
    "debug": "~4.3.1",
    "eventemitter2": "^6.3.1",
    "require-in-the-middle": "^5.0.0",
    "semver": "~7.5.4",
    "shimmer": "^1.2.0",
    "signal-exit": "^3.0.3"
  }
}
